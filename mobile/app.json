{
  "expo": {
    "name": "ToiTime",
    "slug": "toytime",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "kz.toytime.app",
      "infoPlist": {
        "NSContactsUsageDescription": "ToiTime показывает ваши контакты, чтобы вы выбрали гостей. На сервер передаются только выбранные гости."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#123C32",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "kz.toytime.app",
      "permissions": [
        "android.permission.READ_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "ToiTime",
      "shortName": "ToiTime",
      "themeColor": "#123C32"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-contacts",
        {
          "contactsPermission": "ToiTime показывает ваши контакты, чтобы вы выбрали гостей. На сервер передаются только выбранные гости."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ToiTime открывает галерею, чтобы вы выбрали фото или видео для приглашения.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      "expo-font"
    ],
    "scheme": "toytime",
    "extra": {
      "apiUrl": "http://localhost:3000"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    }
  }
}
