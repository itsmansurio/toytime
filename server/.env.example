PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/toytime
# Адрес, по которому гости открывают ссылки (https в продакшене)
PUBLIC_URL=http://localhost:3000
# Длинная случайная строка. Смена отзывает все ссылки гостей.
LINK_SECRET=change-me
ADMIN_TOKEN=change-me
# Только для веб-предпросмотра приложения
CORS_ORIGIN=http://localhost:8081

# WhatsApp Cloud API. Пока true — работает эмулятор, сообщения никуда не уходят.
WHATSAPP_TEST_MODE=true
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Платёжный провайдер. Реальный ещё не подключён, false не запустится.
PAYMENTS_TEST_MODE=true
PAYMENTS_WEBHOOK_SECRET=change-me

# Push через Expo. true — только запись в журнал.
PUSH_TEST_MODE=true
